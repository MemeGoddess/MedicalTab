<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Fluffy</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <AllowedReferenceRelatedFileExtensions>None</AllowedReferenceRelatedFileExtensions>
        <AssemblyTitle>MedicalTab</AssemblyTitle>
        <Product>MedicalTab</Product>
        <Copyright>Copyright © 2015-2021</Copyright>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Version>1.7</Version>
    	<GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>..\..\$(Version)\Assemblies\</OutputPath>
        <DefineConstants>DEBUG</DefineConstants>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>
    <!-- Release configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>embedded</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>..\..\$(Version)\Assemblies\</OutputPath>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(Version).*-*" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
